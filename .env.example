# OpsAI environment template — copy to .env and adjust.
# Never commit real secrets.

# PostgreSQL
POSTGRES_USER=opsai
POSTGRES_PASSWORD=opsai
POSTGRES_DB=opsai
DATABASE_URL=postgresql+psycopg://opsai:opsai@postgres:5432/opsai

# Backend
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3456,http://127.0.0.1:3456
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI — switch provider without code changes (mock | openai | ollama)
# mock: deterministic structured analysis, no API key required (default for local Docker)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
# Optional override (OpenAI default https://api.openai.com/v1; Ollama e.g. http://host.docker.internal:11434/v1)
AI_BASE_URL=

# Frontend (browser-facing URL for the API)
NEXT_PUBLIC_API_URL=http://localhost:8000

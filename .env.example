# OpsAI environment template — copy to .env and adjust.
# Never commit real secrets.

# PostgreSQL
POSTGRES_USER=opsai
POSTGRES_PASSWORD=opsai
POSTGRES_DB=opsai
DATABASE_URL=postgresql+psycopg://opsai:opsai@postgres:5432/opsai

# Backend
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI placeholders (unused in Phase 1)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Frontend (browser-facing URL for the API)
NEXT_PUBLIC_API_URL=http://localhost:8000
